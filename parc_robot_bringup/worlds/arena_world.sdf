<?xml version="1.0"?>
<sdf version='1.10'>
  <world name='arena'>
    <!-- Arene de la phase reelle PARC 2026 : 5 m x 5 m, centre en (0, 0).
         Murets, tables et tags places d'apres la photo, sans mesure :
         les positions des tags et des tables changeront le jour J. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.85 0.85 1</background>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gazon synthetique : visuel seulement, le contact reste celui du sol -->
    <model name='grass'>
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Murets en contreplaque, 0.40 m de haut (estimation) -->
    <model name='walls'>
      <static>true</static>
      <link name='link'>
        <collision name='north'>
          <pose>0 2.51 0.2 0 0 0</pose>
          <geometry><box><size>5.04 0.02 0.4</size></box></geometry>
        </collision>
        <visual name='north'>
          <pose>0 2.51 0.2 0 0 0</pose>
          <geometry><box><size>5.04 0.02 0.4</size></box></geometry>
          <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
        </visual>
        <collision name='south'>
          <pose>0 -2.51 0.2 0 0 0</pose>
          <geometry><box><size>5.04 0.02 0.4</size></box></geometry>
        </collision>
        <visual name='south'>
          <pose>0 -2.51 0.2 0 0 0</pose>
          <geometry><box><size>5.04 0.02 0.4</size></box></geometry>
          <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
        </visual>
        <collision name='east'>
          <pose>2.51 0 0.2 0 0 0</pose>
          <geometry><box><size>0.02 5.0 0.4</size></box></geometry>
        </collision>
        <visual name='east'>
          <pose>2.51 0 0.2 0 0 0</pose>
          <geometry><box><size>0.02 5.0 0.4</size></box></geometry>
          <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
        </visual>
        <collision name='west'>
          <pose>-2.51 0 0.2 0 0 0</pose>
          <geometry><box><size>0.02 5.0 0.4</size></box></geometry>
        </collision>
        <visual name='west'>
          <pose>-2.51 0 0.2 0 0 0</pose>
          <geometry><box><size>0.02 5.0 0.4</size></box></geometry>
          <material><ambient>0.85 0.7 0.55 1</ambient><diffuse>0.85 0.7 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Disposition aleatoire (graine 9959) : passages d'au moins 0.6 m entre
         tables, zone de 0.5 a 1 m devant chaque tag libre, depart degage. -->

    <!-- Tables d'ecole -->
    <include>
      <uri>model://school_desk</uri>
      <name>desk_1</name>
      <pose>0.86 -0.68 0 0 0 2.097</pose>
    </include>
    <include>
      <uri>model://school_desk</uri>
      <name>desk_2</name>
      <pose>-0.11 0.46 0 0 0 0.323</pose>
    </include>
    <include>
      <uri>model://school_desk</uri>
      <name>desk_3</name>
      <pose>-1.29 -0.81 0 0 0 -2.167</pose>
    </include>
    <include>
      <uri>model://school_desk</uri>
      <name>desk_4</name>
      <pose>-1.80 0.43 0 0 0 -0.932</pose>
    </include>

    <!-- AprilTags : centre a 1 m du sol, le tag regarde vers le yaw donne -->
    <include>
      <uri>model://apriltag_1</uri>
      <name>apriltag_1</name>
      <pose>-0.20 1.42 1.0 0 0 3.090</pose>
    </include>
    <include>
      <uri>model://apriltag_4</uri>
      <name>apriltag_4</name>
      <pose>-0.60 -1.22 1.0 0 0 -0.078</pose>
    </include>
    <include>
      <uri>model://apriltag_7</uri>
      <name>apriltag_7</name>
      <pose>0.89 1.90 1.0 0 0 -3.082</pose>
    </include>
    <include>
      <uri>model://apriltag_9</uri>
      <name>apriltag_9</name>
      <pose>1.35 0.41 1.0 0 0 2.087</pose>
    </include>
  </world>
</sdf>
