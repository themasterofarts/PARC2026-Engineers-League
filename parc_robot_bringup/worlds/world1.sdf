      <pose>9.35 0.05 0.864 0 0 0.0</pose>
      <uri>model://steak_set</uri>
      <plugin filename="gz-sim-detachable-joint-system"
          name="gz::sim::systems::DetachableJoint">
        <parent_link>link_0</parent_link>
