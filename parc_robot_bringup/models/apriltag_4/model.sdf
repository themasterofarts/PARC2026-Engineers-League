<?xml version="1.0"?>
<sdf version="1.9">
  <model name="apriltag_4">
    <!-- Origine au centre du tag. Le tag regarde vers +X du modele. -->
    <static>true</static>
    <link name="link">
      <!-- Image de 10 cases : carre noir de 8 cases (16.5 cm) + marge blanche -->
      <visual name="tag">
        <pose>0.006 0 0 1.5708 0 1.5708</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.20625 0.20625</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://apriltag_4/materials/textures/apriltag_4.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="panel">
        <geometry>
          <box>
            <size>0.01 0.24 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
      <!-- Poteau : du sol jusque sous le panneau, centre a 1 m du sol -->
      <visual name="pole">
        <pose>-0.02 0 -0.56 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.03 0.88</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="pole_collision">
        <pose>-0.02 0 -0.56 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.03 0.88</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
