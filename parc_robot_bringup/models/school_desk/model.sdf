<?xml version="1.0"?>
<sdf version="1.9">
  <model name="school_desk">
    <!-- Dimensions estimees sur la photo de l'arene, a remplacer par des mesures.
         Plateau 0.60 x 0.45 m a 0.72 m. Chaque cote : un pied vertical pose
         sur une barre au sol, reliee au plateau par une traverse.
         Barres au sol de 6 cm : a 3 cm, le LiDAR (plan a 3.8 cm) ne les voyait pas
         et le robot montait dessus jusqu a se renverser. -->
    <static>true</static>
    <link name="link">
      <visual name="top">
        <pose>0 0 0.7075 0 0 0</pose>
        <geometry><box><size>0.60 0.45 0.025</size></box></geometry>
        <material>
          <ambient>0.93 0.90 0.84 1</ambient>
          <diffuse>0.93 0.90 0.84 1</diffuse>
        </material>
      </visual>
      <collision name="top">
        <pose>0 0 0.7075 0 0 0</pose>
        <geometry><box><size>0.60 0.45 0.025</size></box></geometry>
      </collision>

      <!-- Cote gauche (x < 0) -->
      <visual name="leg_left">
        <pose>-0.27 0 0.36 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.66</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="leg_left">
        <pose>-0.27 0 0.36 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.66</size></box></geometry>
      </collision>
      <visual name="foot_left">
        <pose>-0.27 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.45 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="foot_left">
        <pose>-0.27 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.45 0.06</size></box></geometry>
      </collision>
      <visual name="rail_left">
        <pose>-0.27 0 0.68 0 0 0</pose>
        <geometry><box><size>0.03 0.40 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Cote droit (x > 0) -->
      <visual name="leg_right">
        <pose>0.27 0 0.36 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.66</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="leg_right">
        <pose>0.27 0 0.36 0 0 0</pose>
        <geometry><box><size>0.03 0.03 0.66</size></box></geometry>
      </collision>
      <visual name="foot_right">
        <pose>0.27 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.45 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="foot_right">
        <pose>0.27 0 0.03 0 0 0</pose>
        <geometry><box><size>0.03 0.45 0.06</size></box></geometry>
      </collision>
      <visual name="rail_right">
        <pose>0.27 0 0.68 0 0 0</pose>
        <geometry><box><size>0.03 0.40 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
