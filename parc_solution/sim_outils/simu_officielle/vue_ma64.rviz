Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Carte SLAM
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: map
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Costmap globale
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Costmap locale
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Volatile
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.5
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Masque keepout
      Enabled: true
      Topic:
        Value: /keepout_filter_mask
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR filtre
      Enabled: true
      Topic:
        Value: /scan_ma64
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan camera haute
      Enabled: true
      Topic:
        Value: /camera1/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 200; 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Obstacles hauts (camera)
      Enabled: true
      Topic:
        Value: /ma64/obstacles_hauts
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.06
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Empreinte
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color: 0; 255; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Plan Nav2
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color: 0; 200; 255
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /camera1/camera1/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 90
      X: 2.5
      Y: 0
      Angle: 0
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
