digraph ros_graph {
  rankdir=LR; splines=true; nodesep=0.3; ranksep=1.2;
  node [fontname="Helvetica", fontsize=11]; edge [color="#8a8984", arrowsize=0.6];
  labelloc=t; fontname="Helvetica"; fontsize=16;
  label="Graphe ROS 2 / ROS 2 graph — flux de données : topics avec publieur et abonné, + actions / data flow: topics with a publisher and a subscriber, + actions\nEllipses = nœuds / nodes · rectangles = topics (type) · hexagones = actions (tirets / dashed)\nMasqués / hidden: /rosout, /parameter_events, /clock (tous les nœuds / every node), transform_listener_impl_*, rosbag2_recorder (banc de test / test harness)";
  "/amcl" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/basic_navigator" [shape=ellipse, style=filled, fillcolor="#d6e6f9", color="#2a78d6", penwidth=2];
  "/behavior_server" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/bt_navigator" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/bt_navigator_navigate_through_poses_rclcpp_node" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/bt_navigator_navigate_to_pose_rclcpp_node" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/controller_server" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/global_costmap/global_costmap" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/imu_odom_corrector" [shape=ellipse, style=filled, fillcolor="#d6e6f9", color="#2a78d6", penwidth=2];
  "/lifecycle_manager_localization" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/lifecycle_manager_navigation" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/local_costmap/local_costmap" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/map_server" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/planner_server" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/robot_state_publisher" [shape=ellipse, style=filled, fillcolor="#fbe0d4", color="#eb6834", penwidth=2];
  "/ros_gz_bridge" [shape=ellipse, style=filled, fillcolor="#fbe0d4", color="#eb6834", penwidth=2];
  "/waypoint_follower" [shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
  "/amcl_pose" [shape=box, style=rounded, fontsize=10, label="/amcl_pose
geometry_msgs/msg/PoseWithCovarianceStamped"];
  "/bond" [shape=box, style=rounded, fontsize=10, label="/bond
bond/msg/Status"];
  "/imu" [shape=box, style=rounded, fontsize=10, label="/imu
sensor_msgs/msg/Imu"];
  "/initialpose" [shape=box, style=rounded, fontsize=10, label="/initialpose
geometry_msgs/msg/PoseWithCovarianceStamped"];
  "/joint_states" [shape=box, style=rounded, fontsize=10, label="/joint_states
sensor_msgs/msg/JointState"];
  "/local_costmap/costmap_raw" [shape=box, style=rounded, fontsize=10, label="/local_costmap/costmap_raw
nav2_msgs/msg/Costmap"];
  "/local_costmap/costmap_raw_updates" [shape=box, style=rounded, fontsize=10, label="/local_costmap/costmap_raw_updates
nav2_msgs/msg/CostmapUpdate"];
  "/local_costmap/published_footprint" [shape=box, style=rounded, fontsize=10, label="/local_costmap/published_footprint
geometry_msgs/msg/PolygonStamped"];
  "/map" [shape=box, style=rounded, fontsize=10, label="/map
nav_msgs/msg/OccupancyGrid"];
  "/odom" [shape=box, style=rounded, fontsize=10, label="/odom
nav_msgs/msg/Odometry"];
  "/robot_base_controller/cmd_vel_unstamped" [shape=box, style=rounded, fontsize=10, label="/robot_base_controller/cmd_vel_unstamped
geometry_msgs/msg/Twist"];
  "/scan" [shape=box, style=rounded, fontsize=10, label="/scan
sensor_msgs/msg/LaserScan"];
  "/tf" [shape=box, style=rounded, fontsize=10, label="/tf
tf2_msgs/msg/TFMessage"];
  "/tf_static" [shape=box, style=rounded, fontsize=10, label="/tf_static
tf2_msgs/msg/TFMessage"];
  "action:/backup" [shape=hexagon, style=dashed, fontsize=10, label="/backup
nav2_msgs/action/BackUp"];
  "action:/compute_path_through_poses" [shape=hexagon, style=dashed, fontsize=10, label="/compute_path_through_poses
nav2_msgs/action/ComputePathThroughPoses"];
  "action:/compute_path_to_pose" [shape=hexagon, style=dashed, fontsize=10, label="/compute_path_to_pose
nav2_msgs/action/ComputePathToPose"];
  "action:/follow_gps_waypoints" [shape=hexagon, style=dashed, fontsize=10, label="/follow_gps_waypoints
nav2_msgs/action/FollowGPSWaypoints"];
  "action:/follow_path" [shape=hexagon, style=dashed, fontsize=10, label="/follow_path
nav2_msgs/action/FollowPath"];
  "action:/follow_waypoints" [shape=hexagon, style=dashed, fontsize=10, label="/follow_waypoints
nav2_msgs/action/FollowWaypoints"];
  "action:/navigate_through_poses" [shape=hexagon, style=dashed, fontsize=10, label="/navigate_through_poses
nav2_msgs/action/NavigateThroughPoses"];
  "action:/navigate_to_pose" [shape=hexagon, style=dashed, fontsize=10, label="/navigate_to_pose
nav2_msgs/action/NavigateToPose"];
  "action:/spin" [shape=hexagon, style=dashed, fontsize=10, label="/spin
nav2_msgs/action/Spin"];
  "action:/wait" [shape=hexagon, style=dashed, fontsize=10, label="/wait
nav2_msgs/action/Wait"];
  "/amcl" -> "/amcl_pose";
  "/amcl_pose" -> "/basic_navigator";
  "/bt_navigator" -> "/bond";
  "/controller_server" -> "/bond";
  "/amcl" -> "/bond";
  "/planner_server" -> "/bond";
  "/map_server" -> "/bond";
  "/behavior_server" -> "/bond";
  "/waypoint_follower" -> "/bond";
  "/lifecycle_manager_navigation" -> "/bond";
  "/lifecycle_manager_localization" -> "/bond";
  "/bond" -> "/bt_navigator";
  "/bond" -> "/controller_server";
  "/bond" -> "/amcl";
  "/bond" -> "/planner_server";
  "/bond" -> "/map_server";
  "/bond" -> "/behavior_server";
  "/bond" -> "/waypoint_follower";
  "/bond" -> "/lifecycle_manager_navigation";
  "/bond" -> "/lifecycle_manager_localization";
  "/ros_gz_bridge" -> "/imu";
  "/imu" -> "/imu_odom_corrector";
  "/basic_navigator" -> "/initialpose";
  "/initialpose" -> "/amcl";
  "/ros_gz_bridge" -> "/joint_states";
  "/joint_states" -> "/robot_state_publisher";
  "/local_costmap/local_costmap" -> "/local_costmap/costmap_raw";
  "/local_costmap/costmap_raw" -> "/behavior_server";
  "/local_costmap/local_costmap" -> "/local_costmap/costmap_raw_updates";
  "/local_costmap/costmap_raw_updates" -> "/behavior_server";
  "/local_costmap/local_costmap" -> "/local_costmap/published_footprint";
  "/local_costmap/published_footprint" -> "/behavior_server";
  "/map_server" -> "/map";
  "/map" -> "/amcl";
  "/map" -> "/global_costmap/global_costmap";
  "/ros_gz_bridge" -> "/odom";
  "/odom" -> "/bt_navigator";
  "/odom" -> "/controller_server";
  "/odom" -> "/imu_odom_corrector";
  "/controller_server" -> "/robot_base_controller/cmd_vel_unstamped";
  "/behavior_server" -> "/robot_base_controller/cmd_vel_unstamped";
  "/robot_base_controller/cmd_vel_unstamped" -> "/ros_gz_bridge";
  "/ros_gz_bridge" -> "/scan";
  "/scan" -> "/local_costmap/local_costmap";
  "/scan" -> "/amcl";
  "/scan" -> "/global_costmap/global_costmap";
  "/amcl" -> "/tf";
  "/robot_state_publisher" -> "/tf";
  "/imu_odom_corrector" -> "/tf";
  "/ros_gz_bridge" -> "/tf";
  "/tf" -> "/bt_navigator";
  "/tf" -> "/amcl";
  "/tf" -> "/behavior_server";
  "/robot_state_publisher" -> "/tf_static";
  "/tf_static" -> "/bt_navigator";
  "/tf_static" -> "/amcl";
  "/tf_static" -> "/behavior_server";
  "/bt_navigator_navigate_to_pose_rclcpp_node" -> "action:/backup" [style=dashed];
  "/bt_navigator_navigate_through_poses_rclcpp_node" -> "action:/backup" [style=dashed];
  "/basic_navigator" -> "action:/backup" [style=dashed];
  "action:/backup" -> "/behavior_server" [style=dashed];
  "/bt_navigator_navigate_through_poses_rclcpp_node" -> "action:/compute_path_through_poses" [style=dashed];
  "/basic_navigator" -> "action:/compute_path_through_poses" [style=dashed];
  "action:/compute_path_through_poses" -> "/planner_server" [style=dashed];
  "/bt_navigator_navigate_to_pose_rclcpp_node" -> "action:/compute_path_to_pose" [style=dashed];
  "/basic_navigator" -> "action:/compute_path_to_pose" [style=dashed];
  "action:/compute_path_to_pose" -> "/planner_server" [style=dashed];
  "/basic_navigator" -> "action:/follow_gps_waypoints" [style=dashed];
  "action:/follow_gps_waypoints" -> "/waypoint_follower" [style=dashed];
  "/bt_navigator_navigate_to_pose_rclcpp_node" -> "action:/follow_path" [style=dashed];
  "/bt_navigator_navigate_through_poses_rclcpp_node" -> "action:/follow_path" [style=dashed];
  "/basic_navigator" -> "action:/follow_path" [style=dashed];
  "action:/follow_path" -> "/controller_server" [style=dashed];
  "/basic_navigator" -> "action:/follow_waypoints" [style=dashed];
  "action:/follow_waypoints" -> "/waypoint_follower" [style=dashed];
  "/basic_navigator" -> "action:/navigate_through_poses" [style=dashed];
  "action:/navigate_through_poses" -> "/bt_navigator" [style=dashed];
  "/bt_navigator" -> "action:/navigate_to_pose" [style=dashed];
  "/waypoint_follower" -> "action:/navigate_to_pose" [style=dashed];
  "/basic_navigator" -> "action:/navigate_to_pose" [style=dashed];
  "action:/navigate_to_pose" -> "/bt_navigator" [style=dashed];
  "/bt_navigator_navigate_to_pose_rclcpp_node" -> "action:/spin" [style=dashed];
  "/bt_navigator_navigate_through_poses_rclcpp_node" -> "action:/spin" [style=dashed];
  "/basic_navigator" -> "action:/spin" [style=dashed];
  "action:/spin" -> "/behavior_server" [style=dashed];
  "/bt_navigator_navigate_to_pose_rclcpp_node" -> "action:/wait" [style=dashed];
  "/bt_navigator_navigate_through_poses_rclcpp_node" -> "action:/wait" [style=dashed];
  "action:/wait" -> "/behavior_server" [style=dashed];
  subgraph cluster_legend { label="Légende / Legend"; fontsize=12; style=dashed; color="#8a8984";
    legend0 [label="Notre solution / Our solution", shape=ellipse, style=filled, fillcolor="#d6e6f9", color="#2a78d6", penwidth=2];
    legend1 [label="Nav2", shape=ellipse, style=filled, fillcolor="#d3f0e4", color="#1baf7a", penwidth=2];
    legend2 [label="Simulateur / Simulator", shape=ellipse, style=filled, fillcolor="#fbe0d4", color="#eb6834", penwidth=2];
    legend3 [label="Autre / Other", shape=ellipse, style=filled, fillcolor="#eeeeec", color="#8a8984", penwidth=2];
  }
}