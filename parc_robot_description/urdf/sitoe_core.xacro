<?xml version="1.0" ?>
<robot name="sitoe" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- Robot's base properties -->
  <xacro:property name="base_length" value="0.4437"/>
  <xacro:property name="base_width" value="1.2714"/>
  <xacro:property name="base_height" value="0.4858"/>

  <!-- Robot's wheel properties -->
  <xacro:property name="wheel_radius" value="0.086"/>
  <xacro:property name="wheel_height" value="0.0446"/>
  <xacro:property name="wheel_mass" value="2.2"/>

  <xacro:property name="caster_wheel_radius" value="0.0508"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 ${pi/2}" xyz="0.0 0.0 0.0381"/>
  </joint>

  <!-- Robot chassis -->
  <link name="base_link">
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/mainbody.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/mainbody001.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/camerasupport.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/camsupport_2.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/emergencybutton.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/trappe.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/hingea.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/hingeb.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/cameracase.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/arducamcover.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/arducamsupport_r.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/arducamsupport_l.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/arducamsupport_lcover.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/arducamsupport_rcover.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/basecovertop.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/backlid.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/backlid001.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/base.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/base001.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/formedhexscrew_am_b18_2_3_2mformedhexscrewm12x1_75x5030wn.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/hexnutjam_am_b18_2_4_5mhexjamnutm12x1_75dn.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/hexnutjam_am_b18_2_4_5mhexjamnutm14x2dn.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/formedhexscrew_am_b18_2_3_2mformedhexscrewm14x2_0x1616wn.dae"/>
      </geometry>
    </visual>
    <collision>
      <!--col__base_link__col_robot_chassis__BoundBox/col_robot_chassis__BoundBox.-->
      <origin rpy="${pi/2} 0 0" xyz="0.0 0.0454341 0.67537"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia mass="15.0" length="${base_length}" width="${base_width}" height="${base_height}">
      <origin xyz="0.105 0 0.0175" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <!-- Right wheel -->
  <link name="right_wheel_link">
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_housing1.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_centerpin.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_housing2.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_tyre.dae"/>
      </geometry>
    </visual>
    <collision>
      <!--col__right_wheel_link__col_right_wheel__BoundCylinder/col_right_wheel__BoundCylinder.-->
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="${wheel_height}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia mass="${wheel_mass}" length="${wheel_height}" radius="${wheel_radius}">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 ${pi/2} 0" xyz="-0.19649 -0.095 0.0476"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_housing001.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_centerpin001.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_housing002.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 -${pi/2} 0" xyz="0.069 0.01075 0.0267"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/botwheel_tyre001.dae"/>
      </geometry>
    </visual>
    <collision>
      <!--col__left_wheel_link__col_left_wheel__BoundCylinder/col_left_wheel__BoundCylinder.-->
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="${wheel_height}" radius="${wheel_radius}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia mass="${wheel_mass}" length="${wheel_height}" radius="${wheel_radius}">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 -${pi/2} 0" xyz="0.19649 -0.095 0.0476"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Caster wheel -->
  <link name="caster_wheel_link">
    <visual>
      <origin rpy="${pi/2} 0 ${pi/2}" xyz="0.133 0.0 0.0"/>
      <geometry>
        <mesh filename="package://parc_robot_description/meshes/caster_wheel.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0026" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_wheel_radius}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia mass="0.45" radius="${caster_wheel_radius}">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </xacro:sphere_inertia>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin rpy="0 0 -${pi/2}" xyz="0.0 0.133 0.0"/>
  </joint>

  <!-- Add friction for gazebo -->

</robot>
